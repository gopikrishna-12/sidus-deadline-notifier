# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Sidus Portal Configuration
PORTAL_URL=https://www.sidus.net/dashboard
API_BASE_URL=https://server.sidus.net

# Monitoring Preferences
# Only alert on ACTIVE assessments due within this many hours (default: 48 = 2 days)
DEADLINE_WINDOW_HOURS=48

# Comma-separated reminder thresholds in hours before deadline
REMINDER_HOURS=24,6,3,2,1

# Timezone for deadline display and /today calculations
TIMEZONE=Asia/Kolkata

